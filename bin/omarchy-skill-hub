#!/usr/bin/env bash
# BareBones Projects, Designed by: Justin Levesque-Welsch
# Desktop application menu entry. Native Quattro popup, never browser.
set -euo pipefail
if ! command -v omarchy-shell >/dev/null 2>&1; then
  echo 'Omarchy Quattro shell is required to open Skill Hub' >&2
  exit 1
fi
exec omarchy-shell shell summon barebones.skill-hub '{}'
